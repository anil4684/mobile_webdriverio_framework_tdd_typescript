{
  "name": "mobile_webdriverio_framework_tdd",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npm run wdio",
    "wdio": "wdio run ./wdio.conf.ts",
    "execute_tc001": "npx wdio run wdio.conf.ts --spec test/specs/TC_001_SearchProduct.spec.ts",
    "execute_tc002": "npx wdio run wdio.conf.ts --spec test/specs/TC_002_AddProductToCart.spec.ts",
    "execute_tc003": "npx wdio run wdio.conf.ts --spec test/specs/TC_003_CheckOut.spec.ts",
    "execute_all": "npx wdio run wdio.conf.ts",
    "clean-allure": "rimraf allure-results allure-report",
    "allure-generate": "npx allure-commandline generate allure-results --clean -o allure-report",
    "allure-open": "npx allure-commandline open allure-report",
    "allure-report": "npm run allure-generate && npm run allure-open",
    "test-with-report": "npm run clean-allure && npm run execute_all && npm run allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.31.7",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "appium-uiautomator2-driver": "^8.6.4",
    "expect-webdriverio": "^6.0.10",
    "mocha": "^12.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
